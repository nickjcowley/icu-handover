{
  "name": "ICU Handover",
  "short_name": "ICU Handover",
  "description": "ICCA handover report as patient cards for phone, tablet or PC. Runs on your device; nothing is uploaded.",
  "id": "./?app=icu-handover",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f5f7",
  "theme_color": "#1f5b8f",
  "lang": "en-GB",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "export",
          "accept": [
            "*/*",
            ".xml",
            "text/xml",
            "application/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/xml": [
          ".xml"
        ],
        "text/xml": [
          ".xml"
        ]
      }
    }
  ]
}